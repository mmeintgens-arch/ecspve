class Fehler(Exception):
    pass


# --- Hilfen ------------------------------------------------------------------------------------------

def ausgabe(daten, code=0):
    print(json.dumps(daten, ensure_ascii=False))
    sys.exit(code)


def ausfuehren(args, timeout=60):
    try:
        p = subprocess.run([str(a) for a in args], capture_output=True, text=True, timeout=timeout,
                           stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", "Zeitüberschreitung"
    except FileNotFoundError:
        return 127, "", f"{args[0]} nicht gefunden"


def lade_konf():
    werte = {"STREETWORKDOC_QUELLE": "/root/StreetworkDoc", "HOST_UPDATE": "ja"}
    try:
        zeilen = KONF.read_text(encoding="utf-8").splitlines()
    except OSError:
        return werte
    for zeile in zeilen:
        zeile = zeile.strip()
        if not zeile or zeile.startswith("#") or "=" not in zeile:
            continue
        k, v = zeile.split("=", 1)
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
            v = v[1:-1]
        werte[k.strip()] = v
    return werte


def ja(wert):
    return str(wert).strip().lower() in ("ja", "1", "true", "yes", "an", "on")


def pvesh(pfad, **param):
    rc, out, err = ausfuehren(["pvesh", "get", pfad, "--output-format", "json",
                               *[t for k, v in param.items() for t in (f"--{k}", str(v))]], timeout=60)
    if rc != 0:
        raise Fehler(f"pvesh {pfad}: {(err.strip().splitlines() or [rc])[-1]}")
    return json.loads(out or "null")


def gast_conf(knoten, typ, gid):
    """Einstellungen eines Gasts direkt aus /etc/pve (schneller als pct config): onboot und Snapshots."""
    ordner = "lxc" if typ == "lxc" else "qemu-server"
    erg = {"onboot": False, "snapshots": [], "da": False}
    try:
        text = (PVE / "nodes" / knoten / ordner / f"{gid}.conf").read_text(encoding="utf-8", errors="replace")
    except OSError:
        return erg
    erg["da"] = True
    haupt = True
    for zeile in text.splitlines():
        m = re.match(r"^\[([^\]]+)\]\s*$", zeile)
        if m:
            haupt = False
            if m.group(1) != "pve:pending":
                erg["snapshots"].append(m.group(1))
        elif haupt and re.match(r"^onboot:\s*1\s*$", zeile):
            erg["onboot"] = True
    return erg


def lokaler_typ(gid):
    for typ in ("lxc", "qemu"):
        if gast_conf(KNOTEN, typ, gid)["da"]:
            return typ
    return None


def gast_status(gid, typ):
    rc, out, _ = ausfuehren(["pct" if typ == "lxc" else "qm", "status", str(gid)], timeout=30)
    return out.split(":", 1)[-1].strip() if rc == 0 else "unbekannt"


def zwischenspeicher(name, sekunden, holen):
    pfad = CACHE / f"{name}.json"
    try:
        if time.time() - pfad.stat().st_mtime < sekunden:
            return json.loads(pfad.read_text())
    except (OSError, ValueError):
        pass
    daten = holen()
    try:
        CACHE.mkdir(mode=0o700, parents=True, exist_ok=True)
        tmp = pfad.with_suffix(".tmp")
        tmp.write_text(json.dumps(daten))
        tmp.replace(pfad)
    except OSError:
        pass
    return daten


def versions_schluessel(text):
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", text)]


def gueltige_id(text):
    if not re.fullmatch(r"[1-9][0-9]{0,8}", text or ""):
        raise Fehler(f"Ungültige ID: {text}")
    return int(text)


def lies_json(pfad, vorgabe):
    try:
        return json.loads(pfad.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return vorgabe


def schreibe_json(pfad, daten):
    pfad.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = pfad.with_suffix(".tmp")
    tmp.write_text(json.dumps(daten, ensure_ascii=False), encoding="utf-8")
    tmp.replace(pfad)


