def host_details():
    erg = {"pve": "", "kernel": os.environ.get("ECSPVE_KERNEL") or os.uname().release, "kernel_neustart": False,
           "updates": None, "update_liste": []}
    rc, out, _ = ausfuehren(["pveversion"], timeout=30)
    m = re.search(r"pve-manager/([0-9][^/\s]*)", out)
    if m:
        erg["pve"] = m.group(1)
    kerne = [p.name[len("vmlinuz-"):] for p in BOOT.glob("vmlinuz-*")]
    if kerne:
        erg["kernel_neustart"] = max(kerne, key=versions_schluessel) != erg["kernel"]
    try:
        pakete = pvesh(f"/nodes/{KNOTEN}/apt/update") or []
        erg["updates"] = len(pakete)
        erg["update_liste"] = [f'{p.get("Package")} {p.get("OldVersion", "")} → {p.get("Version", "")}'
                               for p in pakete[:60]]
    except (Fehler, ValueError):
        pass
    return erg


def fehlgeschlagene_einheiten():
    rc, out, _ = ausfuehren(["systemctl", "list-units", "--failed", "--no-legend", "--plain"], timeout=30)
    return [z.split()[0] for z in out.splitlines() if z.strip()] if rc == 0 else []


def uebersicht():
    gaeste, host = [], {"name": KNOTEN}
    eigene = eigene_pruefungen(lade_konf())
    for r in pvesh("/cluster/resources"):
        typ = r.get("type")
        if typ == "node" and r.get("node") == KNOTEN:
            host.update({k: r.get(k) for k in ("status", "cpu", "maxcpu", "mem", "maxmem", "disk", "maxdisk", "uptime")})
        elif typ in ("lxc", "qemu"):
            gid = int(r["vmid"])
            conf = gast_conf(r.get("node", ""), typ, gid)
            gaeste.append({
                "id": gid, "typ": typ, "name": r.get("name") or f"{typ}-{gid}", "status": r.get("status", "unknown"),
                "knoten": r.get("node"), "lokal": r.get("node") == KNOTEN, "vorlage": bool(r.get("template")),
                "cpu": r.get("cpu") or 0, "maxcpu": r.get("maxcpu") or 0, "mem": r.get("mem") or 0,
                "maxmem": r.get("maxmem") or 0, "disk": r.get("disk") or 0, "maxdisk": r.get("maxdisk") or 0,
                "uptime": r.get("uptime") or 0, "tags": [t for t in re.split(r"[;, ]+", r.get("tags") or "") if t],
                "onboot": conf["onboot"], "snapshots": [s for s in conf["snapshots"] if s.startswith("ecspve_")],
                "pruefung_eigen": eigene.get(str(gid)),
            })
    gaeste.sort(key=lambda g: g["id"])
    host.update(zwischenspeicher("host", 600, host_details))
    host["dienste_fehler"] = fehlgeschlagene_einheiten()
    return {"version": VERSION, "knoten": KNOTEN, "zeit": time.time(), "host": host, "gaeste": gaeste,
            "auftraege": auftraege_liste(30)}


# --- Prüfung der Container ---------------------------------------------------------------------------

def eigene_pruefungen(konf):
    """Eigene Funktionsprüfungen je Container – aus der Oberfläche, helfer.conf hat Vorrang."""
    erg = {gid: {"wert": wert, "quelle": "oberflaeche"} for gid, wert in gespeicherte_pruefungen().items()}
    for k, v in konf.items():
        m = re.fullmatch(r"PRUEFUNG_([0-9]+)", k)
        if m and v.strip():
            erg[m.group(1)] = {"wert": v.strip(), "quelle": "helfer.conf"}
    return erg


def gespeicherte_pruefungen():
    daten = lies_json(PRUEFUNGEN, {})
    return daten if isinstance(daten, dict) else {}


def pruef_adresse(text):
    teile = urllib.parse.urlsplit(text)
    if (len(text) > 300 or teile.scheme not in ("http", "https") or not teile.hostname
            or not re.fullmatch(r"[\x21-\x7e]+", text)):
        raise Fehler("Bitte eine Adresse wie http://127.0.0.1:8080/ angeben (http oder https, ohne Leerzeichen).")
    return text


def probe_skript(gid, konf):
    zeilen = [PROBE]
    eigen = (eigene_pruefungen(konf).get(str(gid)) or {}).get("wert", "")
    for app in APPS:
        aufruf = ""
        if not eigen:
            if app.get("pruefung"):
                aufruf = f"pruefe_url {app['key']} {shlex.quote(app['pruefung'])}"
            elif app.get("pruefbefehl"):
                aufruf = f"pruefe_befehl {app['key']} {shlex.quote(app['pruefbefehl'])}"
        zeilen.append(f'if [ -f /etc/systemd/system/{app["merkmal"]} ]; then echo "app={app["key"]}"; {aufruf or ":"}; fi')
    if eigen:
        art = "pruefe_url" if re.match(r"^https?://", eigen) else "pruefe_befehl"
        zeilen.append(f"{art} eigen {shlex.quote(eigen)}")
    zeilen.append("exit 0")
    return "\n".join(zeilen)


def bewerte_einheit(p):
    if p.get("LoadState") in (None, "", "not-found"):
        return None
    name, aktiv, sub = p.get("Id", "?"), p.get("ActiveState", ""), p.get("SubState", "")
    an = p.get("UnitFileState", "") in ("enabled", "enabled-runtime")
    if aktiv == "failed":
        zustand = "fehler"
    elif aktiv in ("active", "reloading", "activating", "deactivating"):
        zustand = "ok"
    elif not an or (name.endswith(".service") and p.get("Type") == "oneshot"):
        zustand = "ruhe"  # läuft nur per Zeitplan oder bei Bedarf
    else:
        zustand = "fehler"  # eingeschaltet, läuft aber nicht
    return {"name": name, "zustand": zustand, "text": f"{aktiv} ({sub})" if sub else aktiv}


def werte_probe_aus(text):
    erg = {"os": "", "ip": "", "neustart": False, "updates": None, "apps": [], "dienste": [], "pruefungen": []}
    bloecke, block, failed = [], {}, []
    for zeile in text.splitlines():
        if zeile.startswith("u:"):
            k, gleich, v = zeile[2:].partition("=")
            if not gleich:
                if block:
                    bloecke.append(block)
                block = {}
            else:
                block[k] = v
            continue
        k, _, v = zeile.partition("=")
        if k in ("os", "ip"):
            erg[k] = v.strip()
        elif k == "neustart":
            erg["neustart"] = True
        elif k == "updates" and v.strip().isdigit():
            erg["updates"] = int(v)
        elif k == "app" and v not in erg["apps"]:
            erg["apps"].append(v.strip())
        elif k == "failed" and v:
            failed.append(v.strip())
        elif k == "pruefung":
            teile = v.split("|", 3)
            if len(teile) == 4:
                detail = teile[3].strip()
                if detail.startswith("HTTP 000"):
                    detail = "keine Antwort" + detail[8:]
                erg["pruefungen"].append({"app": teile[0], "ok": teile[1] == "1",
                                          "ms": int(teile[2]) if teile[2].isdigit() else None, "detail": detail})
    if block:
        bloecke.append(block)
    namen = set()
    for b in bloecke:
        d = bewerte_einheit(b)
        if d and d["name"] not in namen:
            namen.add(d["name"])
            erg["dienste"].append(d)
    for name in failed:
        if name in LXC_HARMLOS:
            erg["dienste"].append({"name": name, "zustand": "ruhe",
                                   "text": "ausgefallen – im unprivilegierten Container üblich und harmlos"})
        elif name not in namen:
            erg["dienste"].append({"name": name, "zustand": "fehler", "text": "failed"})
    rang = {"fehler": 0, "ok": 1, "ruhe": 2}
    erg["dienste"].sort(key=lambda d: (rang.get(d["zustand"], 3), d["name"].endswith(".timer"), d["name"]))
    erg["ip"] = erg["ip"].split()[0] if erg["ip"] else ""
    return erg


def probe(gid, konf=None):
    konf = konf or lade_konf()
    rc, out, err = ausfuehren(im_ct(gid, "sh", "-c", probe_skript(gid, konf)), timeout=45)
    erg = werte_probe_aus(out)
    erg["zeit"] = time.time()
    if rc != 0 and not out.strip():
        erg["fehler"] = ((err.strip().splitlines() or [f"pct exec endete mit Code {rc}"])[-1])[:200]
    erg["app_name"] = next((APPS_NACH_KEY[a]["name"] for a in erg["apps"] if a in APPS_NACH_KEY), "")
    erg["app_update"] = app_update_befehle(gid, erg["apps"], konf) is not None
    return erg


def pruefen_alle():
    konf = lade_konf()
    ids = []
    for r in pvesh("/cluster/resources"):
        if r.get("type") == "lxc" and r.get("node") == KNOTEN and r.get("status") == "running" and not r.get("template"):
            ids.append(int(r["vmid"]))
    with ThreadPoolExecutor(max_workers=4) as pool:
        ergebnisse = list(pool.map(lambda gid: probe(gid, konf), ids))
    return {str(gid): erg for gid, erg in zip(ids, ergebnisse)}


def app_update_befehle(gid, apps, konf):
    """Befehle (auf dem Host) für das App-Update eines Containers – None, wenn keins eingerichtet ist."""
    eigen = konf.get(f"UPDATE_{gid}", "").strip()
    if eigen:
        return [["bash", "-c", eigen.replace("{id}", str(gid))]]
    quelle = konf.get("STREETWORKDOC_QUELLE", "/root/StreetworkDoc")
    for key in apps:
        app = APPS_NACH_KEY.get(key)
        if not app:
            continue

        def ersetze(teil):
            return teil.replace("{id}", str(gid)).replace("{STREETWORKDOC_QUELLE}", quelle)

        befehl = [ersetze(t) for t in app["update"]]
        if befehl[0].startswith("/"):
            befehl[0] = WURZEL + befehl[0]
        if befehl[0].startswith("/") and not Path(befehl[0]).exists():
            if not app.get("ersatz"):
                continue
            befehl = [ersetze(t) for t in app["ersatz"]]
        schritte = [["git", "-C", ersetze(app["git"]), "pull", "--ff-only"]] if app.get("git") else []
        return schritte + [befehl]
    return None


# --- Aufträge ----------------------------------------------------------------------------------------

def auftrag_pfad(jid, endung):
    return AUFTRAEGE / f"{jid}.{endung}"


def schreibe(job):
    AUFTRAEGE.mkdir(mode=0o700, parents=True, exist_ok=True)
    tmp = auftrag_pfad(job["id"], "tmp")
    tmp.write_text(json.dumps(job, ensure_ascii=False), encoding="utf-8")
    tmp.replace(auftrag_pfad(job["id"], "json"))


def lies(jid):
    if not AUFTRAG_RE.match(jid or ""):
        raise Fehler("Ungültiger Auftrag.")
    try:
        job = json.loads(auftrag_pfad(jid, "json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        raise Fehler(f"Auftrag {jid} gibt es nicht.")
    if job.get("status") in ("wartet", "laeuft") and job.get("pid") and not Path(f"/proc/{job['pid']}").exists():
        job["status"], job["ergebnis"] = "fehler", "abgebrochen (Prozess beendet)"
    return job


def auftraege_liste(anzahl):
    try:
        namen = sorted((p.stem for p in AUFTRAEGE.glob("*.json")), reverse=True)
    except OSError:
        return []
    liste = []
    for jid in namen[:anzahl]:
        try:
            job = lies(jid)
        except Fehler:
            continue
        job.pop("geheim", None)  # z. B. das Root-Passwort eines neuen Containers – nur im einzelnen Auftrag
        liste.append(job)
    return liste


def aufraeumen(behalten=150):
    namen = sorted((p.stem for p in AUFTRAEGE.glob("*.json")), reverse=True)
    for jid in namen[behalten:]:
        for endung in ("json", "log"):
            auftrag_pfad(jid, endung).unlink(missing_ok=True)


def beschaeftigt(gid):
    return any(j["gast"] == gid and j["status"] in ("wartet", "laeuft") for j in auftraege_liste(30))


def neuer_auftrag(art, titel, gast=None, **param):
    if gast is not None and beschaeftigt(gast):
        raise Fehler("Für diesen Gast läuft schon ein Auftrag – bitte warten, bis er fertig ist.")
    jid = time.strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(3)
    job = {"id": jid, "art": art, "titel": titel, "gast": gast, "param": param, "status": "wartet",
           "start": time.time(), "ende": None, "ergebnis": "", "hinweise": [], "pid": None}
    schreibe(job)
    aufraeumen()
    umgebung = {"HOME": "/root", "LC_ALL": "C.UTF-8", "PATH": f"{os.environ.get('PATH', '')}:{PFAD}".strip(":")}
    if shutil.which("systemd-run") and not os.environ.get("ECSPVE_OHNE_SYSTEMD"):
        rc, _, err = ausfuehren(["systemd-run", f"--unit=ecspve-{jid}", "--collect", "--quiet",
                                 *[f"--setenv={k}={v}" for k, v in umgebung.items()],
                                 sys.executable, str(SELBST), "_lauf", jid], timeout=30)
        if rc != 0:
            job.update(status="fehler", ende=time.time(), ergebnis=f"Start fehlgeschlagen: {err.strip()[:200]}")
            schreibe(job)
    else:
        subprocess.Popen([sys.executable, str(SELBST), "_lauf", jid], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         env={**os.environ, **umgebung})
    return job


class Sperre:
    """flock auf eine Datei – hält, bis der Prozess endet oder frei() aufgerufen wird."""

    def __init__(self, name):
        SPERREN.mkdir(mode=0o700, parents=True, exist_ok=True)
        self.fd = os.open(SPERREN / f"{name}.lock", os.O_CREAT | os.O_RDWR, 0o600)

    def nehmen(self, warten=True):
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | (0 if warten else fcntl.LOCK_NB))
            return True
        except BlockingIOError:
            return False

    def frei(self):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)


class Protokoll:
    def __init__(self, jid):
        self.datei = open(auftrag_pfad(jid, "log"), "a", encoding="utf-8")

    def zeile(self, text):
        self.datei.write(f"[{time.strftime('%H:%M:%S')}] {text}\n")
        self.datei.flush()

    def abschnitt(self, text):
        self.zeile(f"=== {text}")

    def befehl(self, args, timeout=3600, umgebung=None):
        self.zeile("$ " + shlex.join(str(a) for a in args))
        try:
            p = subprocess.Popen([str(a) for a in args], stdout=self.datei, stderr=subprocess.STDOUT,
                                 stdin=subprocess.DEVNULL, cwd="/root" if Path("/root").is_dir() else "/",
                                 env={**os.environ, **(umgebung or {})})
        except OSError as e:
            self.zeile(f"Fehler: {e}")
            return 127
        try:
            rc = p.wait(timeout)
        except subprocess.TimeoutExpired:
            p.kill()
            p.wait()
            self.zeile(f"Abgebrochen: länger als {timeout // 60} Minuten")
            return 124
        if rc:
            self.zeile(f"Endete mit Code {rc}")
        return rc


def lauf(jid):
    job = lies(jid)
    job.update(pid=os.getpid())
    schreibe(job)
    log = Protokoll(jid)
    gid = job["gast"]
    sperren = []
    try:
        if job["art"] in ("update", "host-update", "anlegen"):
            # Updates und neue Container nacheinander, nie gleichzeitig (Last, Paketquellen, Snapshots)
            sperren.append(Sperre("updates"))
            if not sperren[-1].nehmen(warten=False):
                log.zeile("Warte, bis der vorige Auftrag fertig ist …")
                sperren[-1].nehmen()
        if gid is not None:
            sperren.append(Sperre(f"gast-{gid}"))
            if not sperren[-1].nehmen(warten=False):
                raise Fehler("Für diesen Gast läuft schon ein Auftrag.")
        else:
            # Aufträge ohne festen Gast (anlegen, auffrischen …) warten auf den vorigen gleicher Art
            sperren.append(Sperre(job["art"]))
            sperren[-1].nehmen()
        job.update(status="laeuft", start=time.time())
        schreibe(job)
        log.abschnitt(job["titel"])
        status, text = AUSFUEHRUNG[job["art"]](job, log)
    except Fehler as e:
        status, text = "fehler", str(e)
    except Exception as e:  # noqa: BLE001 – jeder Fehler soll im Auftrag stehen
        status, text = "fehler", f"Interner Fehler: {e!r}"
    finally:
        for s in reversed(sperren):
            s.frei()
    log.abschnitt(f"Ergebnis: {text}")
    job = lies(jid)
    job.update(status=status, ergebnis=text, ende=time.time())
    schreibe(job)


def a_strom(job, log):
    gid, art = job["gast"], job["param"]["aktion"]
    typ = lokaler_typ(gid)
    if not typ:
        raise Fehler(f"Gast {gid} gibt es auf diesem Knoten nicht.")
    werkzeug = "pct" if typ == "lxc" else "qm"
    befehl = {"start": ["start"], "herunterfahren": ["shutdown", "--timeout", "120"],
              "neustart": ["reboot"], "stopp": ["stop"]}[art]
    rc = log.befehl([werkzeug, befehl[0], gid, *befehl[1:]], timeout=600)
    return ("ok", "Erledigt") if rc == 0 else ("fehler", f"{werkzeug} {befehl[0]} endete mit Code {rc}")


def snapshot(gid, behalten, log):
    name = "ecspve_" + time.strftime("%Y%m%d_%H%M%S")
    log.abschnitt(f"Snapshot {name}")
    if log.befehl(["pct", "snapshot", gid, name, "--description", "Vor Update (ecspve)"], timeout=1800):
        return "Snapshot nicht möglich (Speicher ohne Snapshots oder Bind-Mount?) – Update lief ohne Snapshot."
    alte = sorted(s for s in gast_conf(KNOTEN, "lxc", gid)["snapshots"] if s.startswith("ecspve_"))
    for alt in alte[:-max(behalten, 1)]:
        log.befehl(["pct", "delsnapshot", gid, alt], timeout=1800)
    return None


def stoerungen(erg):
    teile = [f"Dienst {d['name']}" for d in erg.get("dienste", []) if d["zustand"] == "fehler"]
    teile += [f"Prüfung {p['app']} ({p['detail']})" for p in erg.get("pruefungen", []) if not p["ok"]]
    if erg.get("fehler"):
        teile.append(erg["fehler"])
    return teile


def a_update(job, log):
    gid, p = job["gast"], job["param"]
    was = p["was"]
    if lokaler_typ(gid) != "lxc":
        raise Fehler("Updates gibt es nur für Container (LXC) auf diesem Knoten.")
    if gast_status(gid, "lxc") != "running":
        raise Fehler("Der Container läuft nicht – bitte erst starten.")
    konf = lade_konf()
    vorher = probe(gid, konf)
    warnungen, hinweise = [], []
    if p.get("snapshots", 0) > 0:
        w = snapshot(gid, p["snapshots"], log)
        if w:
            warnungen.append(w)
    if was in ("alles", "system"):
        log.abschnitt("Betriebssystem im Container aktualisieren")
        if log.befehl(im_ct(gid, "env", *APT_ENV, "sh", "-c", APT_UPGRADE)):
            raise Fehler("Update des Betriebssystems fehlgeschlagen – Details im Protokoll.")
    if was in ("alles", "app"):
        befehle = app_update_befehle(gid, vorher["apps"], konf)
        if befehle is None:
            if was == "app":
                raise Fehler("Für diesen Container ist kein App-Update eingerichtet.")
            log.zeile("Kein App-Update eingerichtet – übersprungen.")
        else:
            log.abschnitt(f"App aktualisieren ({vorher['app_name'] or 'eigener Befehl'})")
            for befehl in befehle:
                if log.befehl(befehl, umgebung={"HOME": "/root"}):
                    raise Fehler("App-Update fehlgeschlagen – Details im Protokoll.")
    time.sleep(5)
    nachher = probe(gid, konf)
    if nachher["neustart"] and p.get("neustart"):
        log.abschnitt("Container neu starten (vom Update verlangt)")
        log.befehl(["pct", "reboot", gid], timeout=600)
        time.sleep(15)
        nachher = probe(gid, konf)
    elif nachher["neustart"]:
        hinweise.append("Neustart empfohlen")
    probleme = stoerungen(nachher)
    if probleme:
        log.zeile("Nach dem Update gestört – neue Prüfung in 30 Sekunden …")
        time.sleep(30)
        probleme = stoerungen(probe(gid, konf))
    job_hinweise(job, hinweise)
    if probleme:
        return "warnung", "Aktualisiert, aber gestört: " + ", ".join(probleme)
    if warnungen:
        return "warnung", "Aktualisiert. " + " ".join(warnungen)
    return "ok", "Aktualisiert" + (f" – {', '.join(hinweise)}" if hinweise else "")


def job_hinweise(job, hinweise):
    if hinweise:
        job_felder(job, hinweise=hinweise)


def a_dienst(job, log):
    gid, dienst = job["gast"], job["param"]["dienst"]
    rc = log.befehl(im_ct(gid, "systemctl", "restart", dienst), timeout=300)
    log.befehl(im_ct(gid, "systemctl", "--no-pager", "--lines=20", "status", dienst), timeout=60)
    return ("ok", f"{dienst} neu gestartet") if rc == 0 else ("fehler", f"{dienst} startet nicht (Code {rc})")


def a_host_update(job, log):
    env = {k: v for k, v in (e.split("=", 1) for e in APT_ENV)}
    if log.befehl(["apt-get", "update"], timeout=900, umgebung=env):
        raise Fehler("apt-get update fehlgeschlagen (Paketquellen prüfen).")
    if log.befehl(["apt-get", "-y", "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold",
                   "dist-upgrade"], umgebung=env):
        raise Fehler("Update des Hosts fehlgeschlagen – Details im Protokoll.")
    (CACHE / "host.json").unlink(missing_ok=True)
    details = host_details()
    if details["kernel_neustart"]:
        job_hinweise(job, ["Neuer Kernel – Host bei Gelegenheit neu starten"])
        return "ok", "Aktualisiert – neuer Kernel: Host bei Gelegenheit neu starten"
    return "ok", "Aktualisiert"


def a_auffrischen(job, log):
    fehler = []
    for r in pvesh("/cluster/resources"):
        if r.get("type") == "lxc" and r.get("node") == KNOTEN and r.get("status") == "running" and not r.get("template"):
            if log.befehl(im_ct(r["vmid"], "apt-get", "update", "-qq"), timeout=600):
                fehler.append(str(r["vmid"]))
    return ("warnung", f"Nicht möglich in: {', '.join(fehler)}") if fehler else ("ok", "Paketlisten aktuell")


def bruecken():
    return sorted(n["iface"] for n in pvesh(f"/nodes/{KNOTEN}/network", type="any_bridge") or [] if n.get("iface"))


def speicher(inhalt):
    return [{"name": s["storage"], "typ": s.get("type", ""), "frei": s.get("avail"), "gesamt": s.get("total")}
            for s in pvesh(f"/nodes/{KNOTEN}/storage", content=inhalt, enabled=1) or [] if s.get("active")]


def belegt():
    return {(int(r["vmid"]), r.get("name")) for r in pvesh("/cluster/resources") if r.get("type") in ("lxc", "qemu")}


def debian_vorlage(auffrischen=False):
    """Neueste Debian-Standardvorlage – wie in den Install-Skripten der Apps."""
    if auffrischen:
        ausfuehren(["pveam", "update"], timeout=300)
    rc, out, _ = ausfuehren(["pveam", "available", "--section", "system"], timeout=60)
    namen = [z.split()[1] for z in out.splitlines() if len(z.split()) == 2 and VORLAGE_RE.match(z.split()[1])]
    return max(namen, key=versions_schluessel) if namen else None


def anlegen_optionen():
    return {"naechste_id": int(pvesh("/cluster/nextid")), "speicher": speicher("rootdir"), "bruecken": bruecken(),
            "vorlage": debian_vorlage()}


def anlege_parameter(args):
    p = {"name": args[0], "cores": 1, "memory": 1024, "disk": 8, "storage": "", "bridge": "vmbr0", "vlan": None,
         "ip": "dhcp", "gw": "", "ctid": None, "onboot": True, "start": True}
    if not NAME_RE.match(p["name"]):
        raise Fehler("Name: nur Kleinbuchstaben, Ziffern und Bindestrich, z. B. „homeassistant“.")
    grenzen = {"cores": (1, 64), "memory": (256, 262144), "disk": (2, 4096), "vlan": (1, 4094), "ctid": (100, 999999999)}
    for opt in args[1:]:
        schluessel, gleich, wert = opt.partition("=")
        k = schluessel[2:] if schluessel.startswith("--") and gleich else ""
        if k in grenzen:
            if not re.fullmatch(r"[0-9]{1,9}", wert) or not grenzen[k][0] <= int(wert) <= grenzen[k][1]:
                raise Fehler(f"--{k} muss zwischen {grenzen[k][0]} und {grenzen[k][1]} liegen.")
            p[k] = int(wert)
        elif k == "ip":
            if wert != "dhcp":
                try:
                    netz = ipaddress.IPv4Interface(wert)
                except ValueError:
                    raise Fehler("IP-Adresse bitte mit Präfix angeben, z. B. 192.168.10.70/24 – oder dhcp.")
                if "/" not in wert or netz.network.prefixlen in (0, 32):
                    raise Fehler("IP-Adresse bitte mit Präfix angeben, z. B. 192.168.10.70/24.")
            p["ip"] = wert
        elif k == "gw":
            try:
                p["gw"] = str(ipaddress.IPv4Address(wert)) if wert else ""
            except ValueError:
                raise Fehler("Ungültiges Gateway.")
        elif k in ("bridge", "storage"):
            if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", wert):
                raise Fehler(f"Ungültiger Wert für --{k}.")
            p[k] = wert
        elif k in ("onboot", "start"):
            if wert not in ("0", "1"):
                raise Fehler(f"--{k} ist 0 oder 1.")
            p[k] = wert == "1"
        else:
            raise Fehler(f"Unbekannte Option: {opt[:40]}")
    if p["ip"] != "dhcp":
        if not p["gw"]:
            raise Fehler("Bei fester IP-Adresse bitte auch das Gateway angeben.")
        if ipaddress.IPv4Address(p["gw"]) not in ipaddress.IPv4Interface(p["ip"]).network:
            raise Fehler("Das Gateway liegt nicht im Netz der IP-Adresse.")
    if p["bridge"] not in bruecken():
        raise Fehler(f"Netzwerk-Brücke {p['bridge']} gibt es auf diesem Host nicht.")
    namen = [s["name"] for s in speicher("rootdir")]
    if not namen:
        raise Fehler("Kein aktiver Speicher für Container gefunden.")
    p["storage"] = p["storage"] or namen[0]
    if p["storage"] not in namen:
        raise Fehler(f"Speicher {p['storage']} kann keine Container aufnehmen.")
    vorhanden = belegt()
    if p["ctid"] and p["ctid"] in {gid for gid, _ in vorhanden}:
        raise Fehler(f"Die ID {p['ctid']} ist schon vergeben.")
    if p["name"] in {name for _, name in vorhanden}:
        raise Fehler(f"Einen Gast „{p['name']}“ gibt es schon.")
    return p


def a_anlegen(job, log):
    p = job["param"]
    log.abschnitt("Debian-Vorlage suchen")
    vorlage = debian_vorlage(auffrischen=True)
    if not vorlage:
        raise Fehler("Keine Debian-Vorlage gefunden (pveam available --section system).")
    ablagen = [s["name"] for s in speicher("vztmpl")]
    if not ablagen:
        raise Fehler("Kein Speicher für Vorlagen gefunden.")
    ablage = "local" if "local" in ablagen else ablagen[0]
    rc, out, _ = ausfuehren(["pveam", "list", ablage], timeout=60)
    if vorlage not in out:
        log.zeile(f"Lade {vorlage} nach {ablage} …")
        if log.befehl(["pveam", "download", ablage, vorlage], timeout=1800):
            raise Fehler("Die Vorlage konnte nicht geladen werden – Details im Protokoll.")
    gid = p["ctid"] or int(pvesh("/cluster/nextid"))
    vorhanden = belegt()
    if gid in {g for g, _ in vorhanden}:
        raise Fehler(f"Die ID {gid} ist inzwischen vergeben.")
    if p["name"] in {name for _, name in vorhanden}:
        raise Fehler(f"Einen Gast „{p['name']}“ gibt es inzwischen.")
    job_felder(job, gast=gid)
    netz = f"name=eth0,bridge={p['bridge']},ip={p['ip']}"
    netz += f",gw={p['gw']}" if p["ip"] != "dhcp" else ""
    netz += f",tag={p['vlan']}" if p["vlan"] else ""
    log.abschnitt(f"Container {gid} „{p['name']}“ anlegen")
    if log.befehl(["pct", "create", gid, f"{ablage}:vztmpl/{vorlage}", "--hostname", p["name"],
                   "--cores", p["cores"], "--memory", p["memory"], "--swap", 512, "--rootfs", f"{p['storage']}:{p['disk']}",
                   "--net0", netz, "--unprivileged", 1, "--features", "nesting=1", "--onboot", int(p["onboot"]),
                   "--ostype", "debian", "--timezone", "host",
                   "--description", f"Angelegt über die Übersicht (ecspve) am {time.strftime('%d.%m.%Y %H:%M')}."],
                  timeout=1800):
        raise Fehler("Der Container konnte nicht angelegt werden – Details im Protokoll.")
    # Root-Passwort im laufenden Container setzen (über stdin – so steht es weder in der Prozessliste noch im Protokoll)
    if log.befehl(["pct", "start", gid], timeout=300):
        return "warnung", f"Container {gid} angelegt, startet aber nicht – Details im Protokoll."
    zeichen = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789"
    passwort = "".join(secrets.choice(zeichen) for _ in range(20))
    for _ in range(10):
        rc, _, err = ausfuehren(im_ct(gid, "true"), timeout=30)
        if rc == 0:
            break
        time.sleep(2)
    try:
        p_rc = subprocess.run(im_ct(gid, "chpasswd"), input=f"root:{passwort}\n", text=True,
                              capture_output=True, timeout=60).returncode
    except (OSError, subprocess.TimeoutExpired):
        p_rc = 1
    warnungen = []
    if p_rc == 0:
        log.zeile("Root-Passwort gesetzt (steht oben im Auftrag).")
        job_felder(job, geheim={"Root-Passwort": passwort})
    else:
        warnungen.append("Root-Passwort konnte nicht gesetzt werden.")
    log.abschnitt("Auf Netzwerk warten")
    netz_da = False
    for _ in range(30):
        if ausfuehren(im_ct(gid, "getent", "hosts", "deb.debian.org"), timeout=30)[0] == 0:
            netz_da = True
            break
        time.sleep(2)
    if netz_da:
        log.abschnitt("Erstes Update des Betriebssystems")
        if log.befehl(im_ct(gid, "env", *APT_ENV, "sh", "-c", APT_UPGRADE)):
            warnungen.append("Erstes Update fehlgeschlagen.")
    else:
        warnungen.append("Kein Internet im Container (Netzwerk, VLAN, DNS prüfen) – erstes Update übersprungen.")
    if not p["start"]:
        log.befehl(["pct", "shutdown", gid, "--timeout", "60"], timeout=300)
    text = f"Container {gid} „{p['name']}“ angelegt" + ("" if p["start"] else " und wieder ausgeschaltet")
    return ("warnung", f"{text}. {' '.join(warnungen)}") if warnungen else ("ok", text)


def job_felder(job, **felder):
    aktuell = lies(job["id"])
    aktuell.update(felder)
    schreibe(aktuell)
    job.update(felder)


