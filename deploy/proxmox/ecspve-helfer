def lokaler_gast(text):
    gid = gueltige_id(text)
    typ = lokaler_typ(gid)
    if not typ:
        raise Fehler(f"Gast {gid} gibt es auf diesem Knoten nicht.")
    return gid, typ


def befehl(argv, intern):
    if not argv:
        raise Fehler("Befehl fehlt (Hilfe: ecspve-helfer --help).")
    name, args = argv[0], argv[1:]
    if name == "version":
        return {"version": VERSION, "knoten": KNOTEN}
    if name == "uebersicht":
        return uebersicht()
    if name == "pruefen":
        return {"zeit": time.time(), "gaeste": pruefen_alle()}
    if name in STROM and len(args) == 1:
        gid, typ = lokaler_gast(args[0])
        return neuer_auftrag("strom", f"{STROM[name]}: {gid}", gid, aktion=name)
    if name == "update" and len(args) >= 2 and args[1] in UPDATE_WAS:
        gid, typ = lokaler_gast(args[0])
        if typ != "lxc":
            raise Fehler("Updates gibt es nur für Container (LXC).")
        param = {"was": args[1], "snapshots": 0, "neustart": False}
        for opt in args[2:]:
            if re.fullmatch(r"--snapshots=[0-9]", opt):
                param["snapshots"] = int(opt.split("=")[1])
            elif opt == "--neustart":
                param["neustart"] = True
            else:
                raise Fehler(f"Unbekannte Option: {opt}")
        return neuer_auftrag("update", f"Update {UPDATE_WAS[args[1]]}: {gid}", gid, **param)
    if name == "dienst" and len(args) == 2:
        gid, typ = lokaler_gast(args[0])
        if typ != "lxc" or not DIENST_RE.match(args[1]):
            raise Fehler("Ungültiger Dienst.")
        return neuer_auftrag("dienst", f"Dienst neu starten: {gid} {args[1]}", gid, dienst=args[1])
    if name == "host-update" and not args:
        if not ja(lade_konf().get("HOST_UPDATE", "ja")):
            raise Fehler("Host-Updates über die Übersicht sind abgeschaltet (HOST_UPDATE in /etc/ecspve/helfer.conf).")
        return neuer_auftrag("host-update", f"Update Proxmox-Host {KNOTEN}")
    if name == "auffrischen" and not args:
        return neuer_auftrag("auffrischen", "Paketlisten in den Containern neu laden")
    if name == "anlegen-optionen" and not args:
        return anlegen_optionen()
    if name == "anlegen" and args:
        p = anlege_parameter(args)
        return neuer_auftrag("anlegen", f"Container anlegen: {p['name']}", **p)
    if name == "pruefung" and len(args) == 2:
        gid, typ = lokaler_gast(args[0])
        if typ != "lxc":
            raise Fehler("Funktionsprüfungen gibt es nur für Container.")
        if lade_konf().get(f"PRUEFUNG_{gid}", "").strip():
            raise Fehler("Für diesen Container steht die Prüfung in /etc/ecspve/helfer.conf auf dem Host – dort ändern.")
        daten = gespeicherte_pruefungen()
        if args[1] == "--aus":
            daten.pop(str(gid), None)
        else:
            daten[str(gid)] = pruef_adresse(args[1])
        schreibe_json(PRUEFUNGEN, daten)
        return {"ok": True, "pruefung": daten.get(str(gid))}
    if name == "auftrag" and len(args) == 1:
        job = lies(args[0])
        try:
            with open(auftrag_pfad(job["id"], "log"), "rb") as f:
                f.seek(0, os.SEEK_END)
                f.seek(max(0, f.tell() - 65536))
                job["protokoll"] = f.read().decode("utf-8", errors="replace")
        except OSError:
            job["protokoll"] = ""
        return job
    if name == "_lauf" and intern and len(args) == 1:
        lauf(args[0])
        return None
    raise Fehler(f"Unbekannter oder unvollständiger Befehl: {' '.join(argv)[:80]}")


def main():
    if len(sys.argv) > 1:
        # Von Hand (root auf dem Host) oder als Auftrag über systemd-run
        argv, intern = sys.argv[1:], True
        if argv[0] in ("-h", "--help"):
            print(__doc__)
            return
    else:
        # Über den festgelegten SSH-Schlüssel (command="…" ohne Argumente): nur der übermittelte Befehl zählt,
        # interne Befehle (_…) nie.
        try:
            argv = shlex.split(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
        except ValueError:
            ausgabe({"fehler": "Ungültiger Befehl."}, 2)
        intern = False
        if argv and argv[0].startswith("_"):
            ausgabe({"fehler": "Nicht erlaubt."}, 2)
    if os.geteuid() != 0 and not os.environ.get("ECSPVE_TEST"):
        ausgabe({"fehler": "ecspve-helfer muss als root auf dem Proxmox-Host laufen."}, 2)
    try:
        erg = befehl(argv, intern)
    except Fehler as e:
        ausgabe({"fehler": str(e)}, 1)
    if erg is not None:
        ausgabe(erg)


if __name__ == "__main__":
    main()
