# Einstellungen der Übersicht (ecspve). Die meisten Werte gelten nach wenigen Sekunden auch ohne Neustart;
# ADRESSE und PORT erst nach: systemctl restart ecspve

# Proxmox-Host, auf dem ecspve-helfer läuft (trägt pve-install.sh ein)
PVE_HOST=
# Adresse der Proxmox-Oberfläche für die Links (leer = https://PVE_HOST:8006)
PVE_URL=
# Webserver: nur HTTP – HTTPS macht euer Reverse Proxy (Caddy) davor
ADRESSE=0.0.0.0
PORT=8080
# IP(s) eures Reverse Proxys (Caddy), durch Komma getrennt. Dringend empfohlen: Dann geht die Seite nur noch über
# den Proxy (direkt auf Port 8080 nur /health und /ping), die Anmeldung nur über HTTPS, und Sperren treffen die
# echte Besucher-IP.
PROXY_IP=
# Token für Monitoring-Abfragen (/api/status, /metrics) – neu erzeugen: ecspve token --neu
TOKEN=
# Token auch als ?token=… in der Adresse annehmen (landet dann in Protokollen von Proxy und Monitoring) – besser
# als Header „Authorization: Bearer …“ schicken
TOKEN_IN_URL=nein

# --- Updates -------------------------------------------------------------------------------------------
# Snapshot vor jedem Update; so viele bleiben je Container (0 = kein Snapshot)
SNAPSHOTS_BEHALTEN=2
# Container neu starten, wenn ein Update es verlangt (/run/reboot-required)
NEUSTART_NACH_UPDATE=nein
# Proxmox-Host im Nachtlauf mit aktualisieren (apt-get dist-upgrade). Den Neustart nach einem neuen Kernel
# löst ihr selbst aus – die Übersicht zeigt, wenn er fällig ist.
HOST_AUTO_UPDATE=nein
# Uhrzeit des Nachtlaufs: systemctl edit ecspve-nacht.timer (Standard 04:30 plus bis zu 15 Minuten)

# --- Benachrichtigungen --------------------------------------------------------------------------------
# ntfy-Thema (z. B. https://ntfy.sh/ein-geheimes-thema): Störungen, Behebungen und Ergebnis des Nachtlaufs
MELDUNG_URL=
# Zugangstoken für ntfy (nur bei geschütztem Thema)
MELDUNG_TOKEN=
# Push-Adresse für Uptime Kuma oder healthchecks.io, wird jede Minute aufgerufen. {status} wird zu up/down,
# {msg} zum Text, z. B. https://kuma.example.de/api/push/AbCdEf?status={status}&msg={msg}
# Ohne Platzhalter (healthchecks.io) nur, wenn alles in Ordnung ist – bleibt der Aufruf aus, schlägt es Alarm.
HEARTBEAT_URL=
# /health nennt ohne Anmeldung nur die Zahl der Probleme; ja = auch die Texte
HEALTH_DETAILS=nein
# Bei jeder erfolgreichen Anmeldung eine Nachricht an MELDUNG_URL (Sperren nach Fehlversuchen immer)
MELDUNG_ANMELDUNG=ja
